@model IEnumerable<BE_25DH190065.Models.Category>

@{
    ViewBag.Title = "Quản lý danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-3">
    <h2 class="bg-success bg-opacity-25 text-success fw-bold p-3 rounded mb-3">
        DANH SÁCH DANH MỤC SẢN PHẨM
    </h2>

    <div class="mb-3">
        <a href="@Url.Action("Create", "Categories")" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Thêm mới danh mục
        </a>
    </div>

    <div class="table-responsive bg-white shadow-sm rounded">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-info">
                <tr>
                    <th class="col-md-2 text-center">Mã danh mục</th>
                    <th class="col-md-7">Tên danh mục</th>
                    <th class="col-md-3 text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center fw-semibold">#@item.CategoryID</td>
                        <td class="fw-semibold">@item.CategoryName</td>
                        <td class="text-center">
                            <a href="@Url.Action("Edit", "Categories", new { id = item.CategoryID })"
                               class="btn btn-sm btn-primary">
                                Cập nhật
                            </a>
                            <a href="@Url.Action("Details", "Categories", new { id = item.CategoryID })"
                               class="btn btn-sm btn-info text-white mx-1">
                                Chi tiết
                            </a>
                            <a href="@Url.Action("Delete", "Categories", new { id = item.CategoryID })"
                               class="btn btn-sm btn-danger">
                                Xóa
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>