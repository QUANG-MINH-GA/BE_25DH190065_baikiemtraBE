@model BE_25DH190065.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-3">
    <h3 class="mb-4 fw-bold">CHI TIẾT ĐƠN HÀNG</h3>

    <div class="row">
        <!-- Cột trái: Thông tin chung đơn hàng -->
        <div class="col-md-4 mb-4">
            <div class="card p-3 shadow-sm">
                <h6 class="text-muted fw-bold mb-3">THÔNG TIN ĐƠN HÀNG</h6>
                <table class="table table-borderless table-sm mb-0">
                    <tr>
                        <th style="width: 45%;">Ngày đặt hàng</th>
                        <td>@Model.OrderDate.ToString("dd/MM/yyyy hh:mm:ss tt")</td>
                    </tr>
                    <tr>
                        <th>Tên khách hàng</th>
                        <td>@(Model.Customer != null ? Model.Customer.CustomerName : "")</td>
                    </tr>
                    <tr>
                        <th>Tổng giá trị</th>
                        <td class="fw-bold text-danger">@String.Format("{0:0,0}", Model.TotalAmount) đ</td>
                    </tr>
                    <tr>
                        <th>Trạng thái thanh toán</th>
                        <td><span class="badge bg-info text-dark">@Model.PaymentStatus</span></td>
                    </tr>
                    <tr>
                        <th>Địa chỉ giao hàng</th>
                        <td>@Model.AddressDelivery</td>
                    </tr>
                </table>
            </div>
        </div>

        <!-- Cột phải: Bảng danh sách sản phẩm trong đơn -->
        <div class="col-md-8 mb-4">
            <div class="card p-3 shadow-sm">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th colspan="2">Sản phẩm</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderDetails)
                        {
                            <tr>
                                <td style="width: 75px;">
                                    @if (item.Product != null && !string.IsNullOrEmpty(item.Product.ProductImage))
                                    {
                                        <img src="@Url.Content(item.Product.ProductImage)" style="width: 60px; height: 75px; object-fit: contain;" />
                                    }
                                </td>
                                <td>@(item.Product != null ? item.Product.ProductName : "SP #" + item.ProductID)</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">@String.Format("{0:0,0}", item.UnitPrice)</td>
                                <td class="text-end fw-bold">@String.Format("{0:0,0}", item.Quantity * item.UnitPrice)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-2">
        <a href="@Url.Action("UpdateStatus", "Orders", new { id = Model.OrderID })" class="btn btn-primary me-2">
            Cập nhật trạng thái
        </a>
        <a href="@Url.Action("Index", "Orders")" class="btn btn-primary">
            Quay lại danh sách
        </a>
    </div>
</div>