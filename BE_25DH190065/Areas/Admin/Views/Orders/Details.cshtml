@model BE_25DH190065.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success" style="padding: 10px;">CHI TIẾT ĐƠN HÀNG #@Model.OrderID</h2>

<div class="well">
    <dl class="dl-horizontal">
        <dt>Khách hàng:</dt>
        <dd>@Model.Customer.CustomerName (@Model.Customer.CustomerPhone)</dd>

        <dt>Ngày đặt hàng:</dt>
        <dd>@String.Format("{0:dd/MM/yyyy}", Model.OrderDate)</dd>

        <dt>Địa chỉ giao hàng:</dt>
        <dd>@Model.AddressDelivery</dd>

        <dt>Trạng thái thanh toán:</dt>
        <dd>@Model.PaymentStatus</dd>

        <dt>Tổng giá trị đơn:</dt>
        <dd><strong>@String.Format("{0:0,0}", Model.TotalAmount) VNĐ</strong></dd>
    </dl>
</div>

<h3 class="bg-success" style="padding: 10px;">DANH SÁCH SẢN PHẨM TRONG ĐƠN</h3>

<table class="table table-bordered table-striped">
    <tr>
        <th>Hình ảnh</th>
        <th>Tên sản phẩm</th>
        <th>Số lượng</th>
        <th>Đơn giá</th>
        <th>Thành tiền</th>
    </tr>
    @foreach (var detail in Model.OrderDetails)
    {
        <tr>
            <td>
                @if (!string.IsNullOrEmpty(detail.Product.ProductImage))
                {
                    <img src="@Url.Content(detail.Product.ProductImage)" style="width: 80px; height: auto;" />
                }
            </td>
            <td>@detail.Product.ProductName</td>
            <td>@detail.Quantity</td>
            <td>@String.Format("{0:0,0}", detail.UnitPrice) VNĐ</td>
            <td>@String.Format("{0:0,0}", detail.Quantity * detail.UnitPrice) VNĐ</td>
        </tr>
    }
</table>

<p>
    @Html.ActionLink("Quay lại danh sách đơn hàng", "Index", null, new { @class = "btn btn-primary" })
</p>