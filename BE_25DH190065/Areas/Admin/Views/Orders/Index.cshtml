@model PagedList.IPagedList<BE_25DH190065.Models.Order>
@using PagedList.Mvc;

@{
    ViewBag.Title = "Danh sách đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-3">
    <!-- Form tìm kiếm 3 tiêu chí theo mẫu slide -->
    @using (Html.BeginForm("Index", "Orders", FormMethod.Get, new { @class = "row g-3 mb-4 bg-light p-3 rounded border" }))
    {
        <div class="col-md-3">
            <label class="form-label fw-bold">Tên khách hàng</label>
            <input type="text" name="customerName" value="@ViewBag.CustomerName" class="form-control" placeholder="Nhập tên khách hàng..." />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-bold">Trạng thái thanh toán</label>
            <select name="paymentStatus" class="form-select">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="COD" @(ViewBag.PaymentStatus == "COD" ? "selected" : "")>COD (Tiền mặt)</option>
                <option value="Chờ thanh toán" @(ViewBag.PaymentStatus == "Chờ thanh toán" ? "selected" : "")>Chờ thanh toán</option>
                <option value="Đang xử lý" @(ViewBag.PaymentStatus == "Đang xử lý" ? "selected" : "")>Đang xử lý</option>
                <option value="Đang vận chuyển" @(ViewBag.PaymentStatus == "Đang vận chuyển" ? "selected" : "")>Đang vận chuyển</option>
                <option value="Đã giao" @(ViewBag.PaymentStatus == "Đã giao" ? "selected" : "")>Đã giao</option>
                <option value="Đã hủy" @(ViewBag.PaymentStatus == "Đã hủy" ? "selected" : "")>Đã hủy</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label fw-bold">Ngày đặt hàng</label>
            <input type="date" name="orderDate" value="@ViewBag.OrderDate" class="form-control" />
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary px-4 me-2">Tìm kiếm</button>
            <a href="@Url.Action("Index", "Orders")" class="btn btn-outline-secondary">Làm mới</a>
        </div>
    }

    <h4 class="p-2 mb-3 fw-bold" style="background-color: #dff0d8; color: #3c763d;">DANH SÁCH ĐƠN HÀNG</h4>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning text-center fw-bold fs-5 py-4">
            KHÔNG CÓ
        </div>
    }
    else
    {
        <table class="table table-bordered table-hover align-middle bg-white">
            <thead style="background-color: #e8f5e9;">
                <tr>
                    <th>Ngày đặt hàng</th>
                    <th>Tên khách hàng</th>
                    <th>Tổng giá trị</th>
                    <th>Trạng thái thanh toán</th>
                    <th>Địa chỉ giao hàng</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.OrderDate.ToString("dd/MM/yyyy hh:mm:ss tt")</td>
                        <td>@(item.Customer != null ? item.Customer.CustomerName : "Khách vãng lai")</td>
                        <td class="fw-bold text-danger">@String.Format("{0:0,0}", item.TotalAmount) đ</td>
                        <td>@item.PaymentStatus</td>
                        <td>@item.AddressDelivery</td>
                        <td class="text-center">
                            <a href="@Url.Action("DetailedOrder", "Orders", new { id = item.OrderID })" class="text-decoration-none fw-semibold">
                                Chi tiết đơn hàng
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-3">
            @Html.PagedListPager(Model, page => Url.Action("Index", new
            {
                page,
                customerName = ViewBag.CustomerName,
                paymentStatus = ViewBag.PaymentStatus,
                orderDate = ViewBag.OrderDate
            }))
        </div>
    }
</div>