@model BE_25DH190065.Models.ViewModel.ProductSearchVM
@using PagedList.Mvc;

<style>
    .product-thumb {
        height: 150px;
        max-width: 150px;
        object-fit: cover;
    }
</style>

<!-- Hiển thị danh sách sản phẩm -->
@if (Model.Products != null && Model.Products.Any())
{
    <h2 class="bg-success" style="padding: 10px;">DANH SÁCH SẢN PHẨM</h2>

    <table class="table bg-info table-responsive table-bordered">
        <thead>
            <tr>
                <th class="bg-success col-md-2">Hình ảnh</th>
                <th class="bg-success col-md-3">Tên sản phẩm</th>
                <th class="bg-success col-md-2">Đơn giá</th>
                <th class="bg-success col-md-2">Danh mục</th>
                <th class="bg-success col-md-3">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(product.ProductImage))
                        {
                            <img src="@Url.Content(product.ProductImage)" class="product-thumb" onerror="this.src='https://via.placeholder.com/150'" />
                        }
                    </td>
                    <td>@Html.DisplayFor(modelItem => product.ProductName)</td>
                    <td>@String.Format("{0:0,0}", product.ProductPrice) VNĐ</td>
                    <td>@Html.DisplayFor(modelItem => product.Category.CategoryName)</td>
                    <td>
                        @Html.ActionLink("Sửa", "Edit", new { id = product.ProductID }, new { @class = "btn btn-primary btn-sm" })
                        @Html.ActionLink("Chi tiết", "Details", new { id = product.ProductID }, new { @class = "btn btn-primary btn-sm" })
                        @Html.ActionLink("Xóa", "Delete", new { id = product.ProductID }, new { @class = "btn btn-primary btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Hiển thị phân trang giữ nguyên toàn bộ tiêu chí lọc & sắp xếp -->
    <div class="pagination-container">
        Trang @(Model.Products.PageCount < Model.Products.PageNumber ? 0 : Model.Products.PageNumber) / @Model.Products.PageCount
        @Html.PagedListPager(Model.Products, page => Url.Action("Index",
            new
            {
                page,
                searchTerm = Model.SearchTerm,
                minPrice = Model.MinPrice,
                maxPrice = Model.MaxPrice,
                sortOrder = Model.SortOrder
            }))
    </div>
}
else
{
    <p class="alert alert-warning">Không tìm được sản phẩm nào phù hợp.</p>
}

<div class="form-group" style="margin-top: 15px;">
    <div class="col-md-offset-8 col-md-4 text-right">
        @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary" })
    </div>
</div>