@model BE_25DH190065.Models.ViewModel.RegisterVM

@{
    ViewBag.Title = "Thông tin tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h3 class="mb-4" style="color: #444;">THÔNG TIN TÀI KHOẢN CỦA BẠN</h3>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="row">
    <!-- Cột trái: Thông tin cá nhân & Cập nhật -->
    <div class="col-md-7 mb-4">
        <div class="card p-4 shadow-sm border-0">
            <h5 class="mb-3" style="color: #6b8223;">Thông tin cá nhân</h5>
            <hr />
            @using (Html.BeginForm("UpdateProfile", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-bold">Tên đăng nhập</label>
                    @Html.TextBoxFor(m => m.Username, new { @class = "form-control bg-light", @readonly = "readonly" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.CustomerName, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control", required = "required" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.CustomerPhone, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.CustomerPhone, new { @class = "form-control", required = "required" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.CustomerEmail, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.CustomerEmail, new { @class = "form-control", type = "email" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.CustomerAddress, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.CustomerAddress, new { @class = "form-control", required = "required" })
                </div>

                <button type="submit" class="btn text-white px-4" style="background-color: #8ba629;">Lưu thay đổi</button>
            }
        </div>
    </div>

    <!-- Cột phải: Đổi mật khẩu & Lối tắt -->
    <div class="col-md-5 mb-4">
        <div class="card p-4 shadow-sm border-0 mb-3">
            <h5 class="mb-3" style="color: #6b8223;">Đổi mật khẩu</h5>
            <hr />
            @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-bold">Mật khẩu hiện tại</label>
                    <input type="password" name="OldPassword" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Mật khẩu mới</label>
                    <input type="password" name="NewPassword" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Xác nhận mật khẩu mới</label>
                    <input type="password" name="ConfirmNewPassword" class="form-control" required />
                </div>

                <button type="submit" class="btn btn-outline-secondary w-100">Cập nhật mật khẩu</button>
            }
        </div>

        <div class="card p-3 shadow-sm border-0 bg-light">
            <div class="d-flex justify-content-between align-items-center">
                <span>Tra cứu đơn hàng đã đặt:</span>
                <a href="@Url.Action("OrderHistory", "Order")" class="btn btn-sm btn-outline-dark">Lịch sử mua hàng</a>
            </div>
        </div>
    </div>
</div>