@model IEnumerable<BE_25DH190065.Models.Order>

@{
    ViewBag.Title = "Đơn hàng của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string currentStatus = ViewBag.CurrentStatus ?? "all";
    string searchQuery = ViewBag.SearchQuery ?? "";
    string expandStatus = ViewBag.ExpandStatus ?? "";

    // Danh sách 5 trạng thái chuẩn theo yêu cầu
    var statusList = new List<string>
{
        "Chờ thanh toán",
        "Đang xử lý",
        "Đang vận chuyển",
        "Đã giao",
        "Đã huỷ"
    };

    // Chuẩn hóa trạng thái trong DB về đúng 5 trạng thái của Tab
    Func<string, string> normalizeStatus = (st) =>
    {
        if (string.IsNullOrWhiteSpace(st)) return "Chờ thanh toán";
        st = st.Trim();
        if (st.Equals("Đang xử lý", StringComparison.OrdinalIgnoreCase))
            return "Đang xử lý";
        if (st.Equals("Đang vận chuyển", StringComparison.OrdinalIgnoreCase))
            return "Đang vận chuyển";
        if (st.Equals("Đã giao", StringComparison.OrdinalIgnoreCase) ||
            st.Equals("Giao hàng thành công", StringComparison.OrdinalIgnoreCase))
            return "Đã giao";
        if (st.Equals("Đã huỷ", StringComparison.OrdinalIgnoreCase) ||
            st.Equals("Đã hủy", StringComparison.OrdinalIgnoreCase))
            return "Đã huỷ";
        return "Chờ thanh toán";
    };
}

<style>
    .order-tabs {
        display: flex;
        background: #fff;
        border-bottom: 1px solid #e5e5e5;
        margin-bottom: 16px;
        overflow-x: auto;
    }

        .order-tabs a {
            flex: 1;
            text-align: center;
            padding: 14px 10px;
            color: #555;
            text-decoration: none;
            font-weight: 500;
            border-bottom: 3px solid transparent;
            white-space: nowrap;
        }

            .order-tabs a.active {
                color: #0d6efd;
                border-bottom-color: #0d6efd;
                font-weight: 600;
            }

    .order-card {
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 6px;
        padding: 16px 20px;
        margin-bottom: 16px;
    }

    .order-status-header {
        font-size: 14px;
        font-weight: 600;
        color: #666;
        padding-bottom: 10px;
        border-bottom: 1px solid #f0f0f0;
        margin-bottom: 12px;
        display: flex;
        justify-content: space-between;
    }

    .order-product-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px dashed #eee;
    }

    .order-product-info {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .order-product-img {
        width: 68px;
        height: 68px;
        object-fit: cover;
        border: 1px solid #ddd;
        border-radius: 4px;
    }

    .order-footer {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        padding-top: 12px;
    }

    .order-total {
        font-size: 16px;
        margin-bottom: 10px;
    }

        .order-total span {
            font-weight: 700;
            color: #222;
            font-size: 18px;
        }

    .btn-order-action {
        border: 1px solid #0d6efd;
        color: #0d6efd;
        background: #fff;
        padding: 6px 16px;
        border-radius: 4px;
        text-decoration: none;
        font-size: 14px;
        margin-left: 8px;
        transition: 0.2s;
        display: inline-block;
    }

        .btn-order-action:hover {
            background: #0d6efd;
            color: #fff;
        }

    .btn-order-cancel {
        border: 1px solid #dc3545;
        color: #dc3545;
        background: #fff;
        padding: 6px 16px;
        border-radius: 4px;
        text-decoration: none;
        font-size: 14px;
        margin-left: 8px;
        transition: 0.2s;
        display: inline-block;
    }

        .btn-order-cancel:hover {
            background: #dc3545;
            color: #fff;
        }
</style>

<div class="container my-4">
    <h3 class="mb-3 fw-bold">Đơn hàng của tôi</h3>

    <!-- 1. Thanh Tabs trạng thái -->
    <div class="order-tabs shadow-sm rounded-top">
        <a href="@Url.Action("MyOrder", "Order", new { status = "all", search = searchQuery })"
           class="@(currentStatus == "all" ? "active" : "")">Tất cả đơn</a>

        @foreach (var st in statusList)
        {
            <a href="@Url.Action("MyOrder", "Order", new { status = st, search = searchQuery })"
               class="@(currentStatus == st ? "active" : "")">@st</a>
        }
    </div>

    <!-- 2. Phần Tìm kiếm đơn hàng -->
    <form method="get" action="@Url.Action("MyOrder", "Order")" class="mb-4">
        <input type="hidden" name="status" value="@currentStatus" />
        <div class="input-group shadow-sm">
            <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
            <input type="text" name="search" value="@searchQuery" class="form-control border-start-0"
                   placeholder="Tìm đơn hàng theo Mã đơn hàng hoặc Tên sản phẩm..." />
            <button type="submit" class="btn btn-outline-primary px-4">Tìm đơn hàng</button>
        </div>
    </form>

    <!-- 3. Phần Đơn hàng của tôi -->
    @{
        var filteredOrders = currentStatus == "all"
            ? Model.ToList()
            : Model.Where(o => normalizeStatus(o.PaymentStatus) == currentStatus).ToList();
    }

    @if (!filteredOrders.Any())
    {
        <div class="text-center bg-white p-5 rounded shadow-sm border">
            <h5 class="text-muted mb-3">BẠN CHƯA CÓ ĐƠN HÀNG NÀO. HÃY ĐẶT ĐƠN NGAY.</h5>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary px-4">Về trang chủ mua sắm</a>
        </div>
    }
    else
    {
        var groupsToRender = currentStatus == "all"
            ? statusList
            : new List<string> { currentStatus };

        foreach (var groupStatus in groupsToRender)
        {
            var ordersInGroup = filteredOrders
                .Where(o => normalizeStatus(o.PaymentStatus) == groupStatus)
                .OrderByDescending(o => o.OrderDate)
                .ThenByDescending(o => o.OrderID)
                .ToList();

            if (!ordersInGroup.Any()) { continue; }

            bool isExpanded = (expandStatus == groupStatus);
            int takeLimit = isExpanded ? 50 : 2;
            var displayedOrders = ordersInGroup.Take(takeLimit).ToList();

            <div class="mb-4">
                @foreach (var order in displayedOrders)
                {
                    var firstDetail = order.OrderDetails.FirstOrDefault();
                    int firstProductId = firstDetail != null ? firstDetail.ProductID : 0;

                    <div class="order-card shadow-sm">
                        <div class="order-status-header">
                            <span>
                                <i class="fas fa-truck me-1"></i> @groupStatus
                                <span class="text-muted fw-normal ms-2">(Mã ĐH: #@order.OrderID - Ngày đặt: @string.Format("{0:dd/MM/yyyy}", order.OrderDate))</span>
                            </span>
                        </div>

                        <!-- Danh sách sản phẩm trong đơn -->
                        @foreach (var item in order.OrderDetails)
                        {
                            <div class="order-product-row">
                                <div class="order-product-info">
                                    <img src="@Url.Content(item.Product.ProductImage ?? "~/Content/Images/no-image.png")"
                                         alt="@item.Product.ProductName" class="order-product-img" />
                                    <div>
                                        <div class="fw-semibold text-dark">@item.Product.ProductName</div>
                                        <small class="text-muted">Số lượng: x@(item.Quantity)</small>
                                    </div>
                                </div>
                                <div class="fw-semibold text-dark">
                                    @string.Format("{0:N0} đ", item.UnitPrice * item.Quantity)
                                </div>
                            </div>
                        }

                        <!-- Tổng tiền & các nút HỦY ĐƠN / MUA LẠI / XEM CHI TIẾT -->
                        <div class="order-footer">
                            <div class="order-total">
                                Tổng tiền: <span>@string.Format("{0:N0} đ", order.TotalAmount)</span>
                            </div>
                            <div>
                                @if (groupStatus == "Chờ thanh toán")
                                {
                                    <a href="@Url.Action("CancelOrder", "Order", new { id = order.OrderID })"
                                       class="btn-order-cancel"
                                       onclick="return confirm('Bạn có chắc chắn muốn hủy đơn hàng #@order.OrderID không?');">Hủy đơn</a>
                                }

                                <a href="@Url.Action("BuyAgain", "Order", new { orderId = order.OrderID })"
                                   class="btn-order-action">Mua lại</a>

                                @if (firstProductId > 0)
                                {
                                    <a href="@Url.Action("ProductDetail", "Home", new { id = firstProductId })"
                                       class="btn-order-action">Xem chi tiết</a>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- Nút Xem thêm -->
                @if (ordersInGroup.Count > 2 && !isExpanded)
                {
                    <div class="text-center mb-3">
                        <a href="@Url.Action("MyOrder", "Order", new { status = currentStatus, search = searchQuery, expandStatus = groupStatus })"
                           class="btn btn-light border px-4 text-secondary">
                            Xem thêm (@(Math.Min(ordersInGroup.Count, 50) - 2) đơn hàng gần nhất)
                        </a>
                    </div>
                }
            </div>
        }
    }
</div>