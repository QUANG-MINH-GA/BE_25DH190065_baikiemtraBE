@model IEnumerable<BE_25DH190065.Models.Order>

@{
    ViewBag.Title = "Đơn hàng của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string currentTab = ViewBag.StatusTab ?? "Tất cả đơn";
    string searchTerm = ViewBag.SearchTerm ?? "";
    bool showAll = ViewBag.ShowAll ?? false;
    int totalMatched = ViewBag.TotalMatchedCount ?? 0;

    string[] tabs = new[] { "Tất cả đơn", "Chờ thanh toán", "Đang xử lý", "Đang vận chuyển", "Đã giao", "Đã hủy" };
}

<style>
    .order-tabs {
        display: flex;
        background: #fff;
        border-bottom: 1px solid #e0e0e0;
        margin-bottom: 15px;
    }

    .order-tab-item {
        flex: 1;
        text-align: center;
        padding: 12px 8px;
        text-decoration: none;
        color: #555;
        font-weight: 500;
        font-size: 14px;
        border-bottom: 2px solid transparent;
    }

        .order-tab-item:hover {
            color: #8ba629;
        }

        .order-tab-item.active {
            color: #8ba629;
            border-bottom: 2px solid #8ba629;
            font-weight: 700;
        }

    .order-card {
        background: #fff;
        border: 1px solid #eaeaea;
        border-radius: 6px;
        padding: 16px;
        margin-bottom: 16px;
    }
</style>

<h4 class="mb-3 fw-bold" style="color: #333;">Đơn hàng của tôi</h4>

<!-- 6 Tab trạng thái đơn hàng theo slide[cite: 11] -->
<div class="order-tabs shadow-sm">
    @foreach (var tab in tabs)
    {
        <a href="@Url.Action("MyOrder", "Order", new { statusTab = tab, searchTerm = searchTerm })"
           class="order-tab-item @(currentTab == tab ? "active" : "")">
            @tab
        </a>
    }
</div>

<!-- Thanh tìm kiếm theo Mã đơn hàng hoặc Tên sản phẩm[cite: 11] -->
@using (Html.BeginForm("MyOrder", "Order", FormMethod.Get, new { @class = "input-group mb-4 shadow-sm" }))
{
    <input type="hidden" name="statusTab" value="@currentTab" />
    <input type="text" name="searchTerm" value="@searchTerm" class="form-control" placeholder="Tìm đơn hàng theo Mã đơn hàng hoặc Tên sản phẩm..." />
    <button type="submit" class="btn text-white px-4" style="background-color: #8ba629;">Tìm đơn hàng</button>
}

<!-- Kiểm tra nếu chưa có đơn hàng nào[cite: 11] -->
@if (Model == null || !Model.Any())
{
    <div class="card p-5 text-center border-0 shadow-sm">
        <p class="fw-bold fs-5 text-muted mb-3">BẠN CHƯA CÓ ĐƠN HÀNG NÀO. HÃY ĐẶT ĐƠN NGAY.</p>
        <div>
            <a href="@Url.Action("Index", "Home")" class="btn text-white px-4" style="background-color: #8ba629;">
                Đến trang chủ mua sắm
            </a>
        </div>
    </div>
}
else
{
    if (currentTab == "Tất cả đơn")
    {
        // Gom nhóm đơn hàng theo trạng thái đơn, mỗi trạng thái hiển thị tối đa 2 đơn gần nhất[cite: 11]
        var groupedOrders = Model.GroupBy(o => string.IsNullOrEmpty(o.PaymentStatus) ? "Đang xử lý" : o.PaymentStatus);

        foreach (var group in groupedOrders)
        {
            string groupStatus = (group.Key == "COD" || group.Key == "Chờ xử lý") ? "Đang xử lý" : group.Key;
            var ordersToShow = group.OrderByDescending(o => o.OrderDate).Take(2).ToList();

            foreach (var order in ordersToShow)
            {
                var firstDetail = order.OrderDetails.FirstOrDefault();
                <div class="order-card shadow-sm">
                    <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom">
                        <span class="fw-semibold text-muted small">
                            Trạng thái: <strong style="color: #6b8223;">@order.PaymentStatus</strong> | Mã ĐH: #@order.OrderID (@order.OrderDate.ToString("dd/MM/yyyy"))
                        </span>
                        @if (order.PaymentStatus != "Đã hủy" && order.PaymentStatus != "Đã giao")
                        {
                            using (Html.BeginForm("CancelOrder", "Order", new { id = order.OrderID }, FormMethod.Post, new { style = "display:inline;" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Xác nhận hủy đơn hàng #@order.OrderID?');">Hủy đơn</button>
                            }
                        }
                    </div>

                    @foreach (var detail in order.OrderDetails)
                    {
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="d-flex align-items-center">
                                <img src="@Url.Content(detail.Product.ProductImage)" style="width: 60px; height: 60px; object-fit: contain;" class="border rounded me-3" />
                                <div>
                                    <div class="fw-semibold">@detail.Product.ProductName</div>
                                    <div class="text-muted small">Số lượng: x@(detail.Quantity)</div>
                                </div>
                            </div>
                            <div class="fw-bold">@String.Format("{0:0,0}", detail.UnitPrice) đ</div>
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-center pt-3 mt-2 border-top">
                        <div>
                            @if (group.Count() > 2)
                            {
                                <a href="@Url.Action("MyOrder", "Order", new { statusTab = groupStatus, showAll = true })" class="btn btn-sm btn-outline-secondary">
                                    Xem thêm (@group.Count() đơn)
                                </a>
                            }
                        </div>
                        <div class="text-end">
                            <div class="mb-2">Tổng tiền: <strong class="text-danger fs-5">@String.Format("{0:0,0}", order.TotalAmount) đ</strong></div>
                            @if (firstDetail != null)
                            {
                                <a href="@Url.Action("AddToCart", "Cart", new { id = firstDetail.ProductID, quantity = 1 })" class="btn btn-sm btn-outline-primary me-1">
                                    Mua lại
                                </a>
                                <a href="@Url.Action("ProductDetail", "Home", new { id = firstDetail.ProductID })" class="btn btn-sm btn-outline-secondary">
                                    Xem chi tiết
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    }
    else
    {
        // Hiển thị danh sách của 1 tab trạng thái cụ thể[cite: 11]
        foreach (var order in Model)
        {
            var firstDetail = order.OrderDetails.FirstOrDefault();
            <div class="order-card shadow-sm">
                <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom">
                    <span class="fw-semibold text-muted small">
                        Trạng thái: <strong style="color: #6b8223;">@order.PaymentStatus</strong> | Mã ĐH: #@order.OrderID (@order.OrderDate.ToString("dd/MM/yyyy"))
                    </span>
                </div>

                @foreach (var detail in order.OrderDetails)
                {
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center">
                            <img src="@Url.Content(detail.Product.ProductImage)" style="width: 60px; height: 60px; object-fit: contain;" class="border rounded me-3" />
                            <div>
                                <div class="fw-semibold">@detail.Product.ProductName</div>
                                <div class="text-muted small">Số lượng: x@(detail.Quantity)</div>
                            </div>
                        </div>
                        <div class="fw-bold">@String.Format("{0:0,0}", detail.UnitPrice) đ</div>
                    </div>
                }

                <div class="text-end pt-3 mt-2 border-top">
                    <div class="mb-2">Tổng tiền: <strong class="text-danger fs-5">@String.Format("{0:0,0}", order.TotalAmount) đ</strong></div>
                    @if (firstDetail != null)
                    {
                        <a href="@Url.Action("AddToCart", "Cart", new { id = firstDetail.ProductID, quantity = 1 })" class="btn btn-sm btn-outline-primary me-1">
                            Mua lại
                        </a>
                        <a href="@Url.Action("ProductDetail", "Home", new { id = firstDetail.ProductID })" class="btn btn-sm btn-outline-secondary">
                            Xem chi tiết
                        </a>
                    }
                </div>
            </div>
        }

        if (!showAll && totalMatched > 2)
        {
            <div class="text-center mt-3">
                <a href="@Url.Action("MyOrder", "Order", new { statusTab = currentTab, searchTerm = searchTerm, showAll = true })" class="btn btn-outline-secondary px-4">
                    Xem thêm (tối đa 50 đơn gần nhất)
                </a>
            </div>
        }
    }
}