@model BE_25DH190065.Models.ViewModel.CheckoutVM

@{
    ViewBag.Title = "Thanh toán đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4">XÁC NHẬN ĐẶT HÀNG</h2>

@using (Html.BeginForm("Checkout", "Order", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="row">
        <div class="col-md-7">
            <div class="card p-4 mb-3">
                <h5>Thông tin giao hàng & Thanh toán</h5>
                <hr />
                <div class="mb-3">
                    @Html.LabelFor(m => m.ShippingAddress, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.ShippingAddress, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.ShippingAddress, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Phương thức giao hàng</label>
                    <div>
                        <label class="me-3">@Html.RadioButtonFor(m => m.ShippingMethod, "Giao hàng nhanh", new { @checked = "checked" }) Giao hàng nhanh</label>
                        <label>@Html.RadioButtonFor(m => m.ShippingMethod, "Giao hàng tiết kiệm") Giao hàng tiết kiệm</label>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Phương thức thanh toán</label>
                    <div>
                        <label class="me-3">@Html.RadioButtonFor(m => m.PaymentMethod, "Tiền mặt", new { @checked = "checked" }) Tiền mặt (COD)</label>
                        <label class="me-3">@Html.RadioButtonFor(m => m.PaymentMethod, "Chuyển khoản") Chuyển khoản ngân hàng</label>
                        <label>@Html.RadioButtonFor(m => m.PaymentMethod, "Ví điện tử") Ví điện tử</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card p-4">
                <h5>Đơn hàng của bạn</h5>
                <hr />
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Sản phẩm</th>
                            <th>SL</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.CartItems)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td>@item.Quantity</td>
                                <td class="text-end">@String.Format("{0:0,0}", item.TotalPrice) đ</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <hr />
                <div class="d-flex justify-content-between mb-3">
                    <strong>Tổng cộng:</strong>
                    <strong class="text-danger fs-5">@String.Format("{0:0,0}", Model.TotalAmount) VNĐ</strong>
                </div>
                <button type="submit" class="btn btn-danger w-100">ĐẶT HÀNG NGAY</button>
            </div>
        </div>
    </div>
}